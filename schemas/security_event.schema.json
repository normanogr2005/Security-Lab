{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/normanogr2005/Security-Lab/security-event.schema.json",
  "title": "Security Lab Event",
  "description": "Common event format for Security-Lab integrations.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "source",
    "event_type",
    "severity"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "netscope",
        "socforge"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "destination_ip": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "source_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "destination_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
